{
  "name": "cronkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "description": "Windows workspace scheduler with tray: SVN update, Unity warmup, scripts.",
  "author": "AgentsHelpMe",
  "scripts": {
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win",
    "self-test": "electron-vite build && electron . --self-test",
    "ui-preview": "vite --config tools/ui-preview/vite.config.ts",
    "cli": "tsx src/cli.ts",
    "validate": "tsx src/cli.ts validate",
    "status": "tsx src/cli.ts status",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cron-parser": "^5.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
