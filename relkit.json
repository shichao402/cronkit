{
  "product": "cronkit",
  "defaultChannel": "stable",
  "channels": [
    "stable",
    "beta"
  ],
  "codeStrategy": "version-build",
  "backends": {
    "local": {
      "type": "local",
      "baseUrl": "https://raw.firoyang.com/rup/",
      "outputDir": "dist/publish"
    },
    "cos": {
      "type": "s3-compatible",
      "endpoint": "https://cos.ap-guangzhou.myqcloud.com",
      "bucket": "relkit-updates-1251882798",
      "region": "ap-guangzhou",
      "prefix": "rup/",
      "baseUrl": "https://raw.firoyang.com/rup/",
      "accessKeyEnv": "COS_SECRET_ID",
      "secretKeyEnv": "COS_SECRET_KEY"
    }
  },
  "publishTo": [
    "local"
  ],
  "directory": {
    "publishTo": [
      "local"
    ],
    "entryUrls": [
      "https://raw.firoyang.com/rup/directory/cronkit.pb"
    ],
    "services": [
      {
        "id": "cos-guangzhou",
        "priority": 0,
        "channel": "stable",
        "indexUrl": "https://raw.firoyang.com/rup/index/cronkit/stable.pb",
        "fallbackUrl": "https://raw.firoyang.com/rup/fallback/cronkit/stable.pb"
      },
      {
        "id": "cos-guangzhou-beta",
        "priority": 0,
        "channel": "beta",
        "indexUrl": "https://raw.firoyang.com/rup/index/cronkit/beta.pb",
        "fallbackUrl": "https://raw.firoyang.com/rup/fallback/cronkit/beta.pb"
      }
    ]
  },
  "signing": {
    "keyId": "cronkit-2026",
    "privateKeyEnv": "RELKIT_PRIVATE_KEY",
    "privateKeyPath": null,
    "publicKeys": [
      {
        "keyId": "cronkit-2026",
        "publicKeyBase64": "iDVCC4DBw1weJn8gl+D82ap3j+ueHV/OksSdlt2SGvk="
      }
    ]
  },
  "site": {
    "title": "cronkit",
    "description": "Windows workspace scheduler with tray: SVN update, Unity warmup, scripts.",
    "homepage": ""
  }
}
