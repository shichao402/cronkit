{
  "product": "cronkit",
  "sidecar": {
    "packScript": "scripts/package-versioned.mjs"
  },
  "updater": {
    "urlAllowlist": [
      "src/core/update/config.ts",
      "tools/ui-preview/mock-api.ts",
      "scripts/relkit-smoke.mjs"
    ]
  },
  "agent": {
    "url": "https://publish.firoyang.com/v1/"
  },
  "release": {
    "packScript": "scripts/package-release.mjs"
  },
  "defaultChannel": "stable",
  "channels": [
    "stable",
    "dev"
  ],
  "codeStrategy": "version-build",
  "backends": {
    "cos": {
      "type": "s3-compatible",
      "endpoint": "https://cos.ap-guangzhou.myqcloud.com",
      "bucket": "relkit-updates-1251882798",
      "region": "ap-guangzhou",
      "prefix": "rup/",
      "baseUrl": "https://raw.firoyang.com/rup/",
      "accessKeyEnv": "COS_SECRET_ID",
      "secretKeyEnv": "COS_SECRET_KEY"
    },
    "serve": {
      "type": "relkit-compatible",
      "baseUrl": "https://publish.firoyang.com/",
      "uploadUrl": "https://publish.firoyang.com/",
      "tokenEnv": "RELKIT_SERVE_TOKEN",
      "timeoutSeconds": 600
    }
  },
  "publishTo": [
    "serve"
  ],
  "directory": {
    "publishTo": [
      "serve"
    ],
    "entryUrls": [
      "https://update-internal.firoyang.com/directory/cronkit.pb"
    ],
    "services": [
      {
        "id": "update-internal-primary",
        "priority": 10,
        "indexUrl": "https://update-internal.firoyang.com/index/cronkit/stable.pb",
        "channel": "stable"
      },
      {
        "id": "update-internal-dev",
        "priority": 10,
        "indexUrl": "https://update-internal.firoyang.com/index/cronkit/dev.pb",
        "channel": "dev"
      }
    ]
  },
  "signing": {
    "keyId": "cronkit-2026",
    "publicKeys": [
      {
        "keyId": "cronkit-2026",
        "publicKeyBase64": "iDVCC4DBw1weJn8gl+D82ap3j+ueHV/OksSdlt2SGvk="
      }
    ]
  },
  "site": {
    "title": "cronkit",
    "description": "Windows workspace scheduler with tray: SVN update, Unity warmup, scripts.",
    "homepage": "https://github.com/shichao402/cronkit"
  }
}